{
  "name": "shiba-island",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "smoke": "node scripts/smoke.mjs",
    "shot": "node scripts/shot.cjs",
    "behavior": "node scripts/behavior-test.mjs",
    "pet": "vite build && electron .",
    "icon": "node scripts/make-icon.cjs",
    "dist": "vite build && node scripts/make-icon.cjs && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0",
    "mp4-muxer": "^5.2.2",
    "three": "^0.170.0",
    "vite": "^5.4.0"
  },
  "description": "柴犬小岛 · 3D 桌宠",
  "author": "shiba-island",
  "build": {
    "appId": "com.shiba-island.pet",
    "productName": "柴犬小岛",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "柴犬小岛.exe"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
